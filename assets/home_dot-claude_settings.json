{
  "cleanupPeriodDays": 90,
  "permissions": {
    "allow": [
      "Bash(git blame:*)",
      "Bash(git branch:*)",
      "Bash(git check-ignore:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(mempalace:*)",
      "Bash(semble:*)",
      "mcp__semble",
      "mcp__mempalace"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "claude-statusline prompt"
  }
}
